# Copie este arquivo para ".env" (local) ou cadastre cada variável em Environment no Render.
# NUNCA coloque valores reais neste arquivo nem suba o ".env" para o GitHub.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Use um texto longo e aleatório (ex.: 40+ caracteres). Trocar este valor desloga todo mundo.
JWT_SECRET=

PORT=5000

# Opcional: endereço do front-end publicado. Se definido, só ele pode chamar a API pelo navegador.
# Ex.: https://futlink-front.onrender.com
FRONTEND_URL=
